{
  "name": "companion-chat-desktop",
  "productName": "Companion Chat",
  "version": "1.2.15",
  "private": true,
  "description": "Companion Chat — local-first AI companion (frameless desktop shell)",
  "main": "main.js",
  "author": "zeroa234",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.venomaru.companionchat",
    "productName": "Companion Chat",
    "directories": {
      "output": "../output/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "web-storage.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../output/web-stage",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Companion Chat",
      "uninstallDisplayName": "Companion Chat",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CompanionChat-Setup-${version}.${ext}"
    }
  }
}
